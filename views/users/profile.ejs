<% layout("/layouts/boilerplate") %>

<div class="container mt-5 mb-5">

    <div class="row g-4">

        <!-- ================= LEFT PROFILE CARD ================= -->

        <div class="col-lg-4">

            <div class="card shadow rounded-4 border-0">

                <div class="card-body text-center">

                    <img
                        src="<%= user.profileImage %>"
                        class="rounded-circle border shadow"
                        width="170"
                        height="170"
                        style="object-fit:cover;"
                    >

                    <h3 class="mt-3 fw-bold">
                        <%= user.username %>
                    </h3>

                    <p class="text-muted">
                        <%= user.bio %>
                    </p>

                    <% if(user.isSuperHost){ %>

                        <span class="badge bg-danger fs-6">
                            ⭐ Super Host
                        </span>

                    <% } %>

                    <hr>

                    <p>

                        <i class="fa-solid fa-envelope text-danger"></i>

                        <%= user.email %>

                    </p>

                    <p>

                        <i class="fa-solid fa-phone text-success"></i>

                        <%= user.phone || "Not Added" %>

                    </p>

                    <p>

                        <i class="fa-solid fa-location-dot text-primary"></i>

                        <%= user.city || "" %>

                        <% if(user.city && user.state){ %>, <% } %>

                        <%= user.state || "" %>

                        <% if(user.country){ %>, <% } %>

                        <%= user.country %>

                    </p>

                    <a
                        href="/profile/edit"
                        class="btn btn-dark w-100 mt-3"
                    >

                        Edit Profile

                    </a>

                </div>

            </div>

        </div>

        <!-- ================= RIGHT SIDE ================= -->

        <div class="col-lg-8">

            <!-- Statistics -->

            <div class="card shadow rounded-4 border-0 mb-4">

                <div class="card-body">

                    <h3 class="mb-4">

                        <i class="fa-solid fa-chart-simple"></i>

                        Profile Statistics

                    </h3>

                    <div class="row text-center">

                        <div class="col-md-3">

                            <h2 class="text-danger fw-bold">

                                <%= totalBookings %>

                            </h2>

                            <p>Total Bookings</p>

                        </div>

                        <div class="col-md-3">

                            <h2 class="text-primary fw-bold">

                                <%= totalListings %>

                            </h2>

                            <p>Hosted Listings</p>

                        </div>

                        <div class="col-md-3">

                            <h2 class="text-success fw-bold">

                                <%= user.wishlist.length %>

                            </h2>

                            <p>Wishlist</p>

                        </div>

                        <div class="col-md-3">

                            <h2 class="text-warning fw-bold">

                                ⭐ <%= averageRating || 5 %>

                            </h2>

                            <p>Rating</p>

                        </div>

                    </div>

                </div>

            </div>

            <!-- About -->

            <div class="card shadow rounded-4 border-0 mb-4">

                <div class="card-body">

                    <h4>

                        <i class="fa-solid fa-user"></i>

                        About Me

                    </h4>

                    <hr>

                    <p>

                        <%= user.bio %>

                    </p>

                </div>

            </div>

            <!-- Host Information -->

            <div class="card shadow rounded-4 border-0 mb-4">

                <div class="card-body">

                    <h4>

                        <i class="fa-solid fa-house-user"></i>

                        Host Information

                    </h4>

                    <hr>

                    <div class="row">

                        <div class="col-md-6">

                            <p>

                                <strong>Super Host :</strong>

                                <%= user.isSuperHost ? "Yes" : "No" %>

                            </p>

                            <p>

                                <strong>Response Rate :</strong>

                                <%= user.responseRate %>%

                            </p>

                        </div>

                        <div class="col-md-6">

                            <p>

                                <strong>Response Time :</strong>

                                <%= user.responseTime %>

                            </p>

                            <p>

                                <strong>Country :</strong>

                                <%= user.country %>

                            </p>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Member Information -->

            <div class="card shadow rounded-4 border-0">

                <div class="card-body">

                    <h4>

                        <i class="fa-solid fa-id-card"></i>

                        Member Information

                    </h4>

                    <hr>

                    <div class="row">

                        <div class="col-md-6">

                            <p>

                                <strong>Member Since :</strong>

                                <%= user.createdAt ? user.createdAt.toDateString() : "Recently Joined" %>

                            </p>

                        </div>

                        <div class="col-md-6">

                            <p>

                                <strong>Email Verified :</strong>

                                <%= user.isEmailVerified ? "Yes" : "No" %>

                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>