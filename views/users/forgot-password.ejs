<% layout("/layouts/boilerplate") %>

<div class="row mt-5">

    <div class="col-md-6 offset-md-3">

        <h2>Forgot Password</h2>

        <form action="/forgot-password" method="POST">

            <div class="mb-3">

                <label>Email</label>

                <input
                    type="email"
                    name="email"
                    class="form-control"
                    required>

            </div>

            <button class="btn btn-dark">
                Send OTP
            </button>

        </form>

    </div>

</div>