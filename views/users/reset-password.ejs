<% layout("/layouts/boilerplate") %>

<div class="row mt-5">

    <div class="col-md-6 offset-md-3">

        <h2>Reset Password</h2>

        <form action="/reset-password" method="POST">

            <div class="mb-3">

                <label>OTP</label>

                <input
                    type="text"
                    name="otp"
                    class="form-control"
                    maxlength="6"
                    required>

            </div>

            <div class="mb-3">

                <label>New Password</label>

                <input
                    type="password"
                    name="password"
                    class="form-control"
                    required>

            </div>

            <button class="btn btn-dark">
                Reset Password
            </button>

        </form>

    </div>

</div>