<% layout("/layouts/boilerplate") %>

<style>
    .planner-card { max-width: 560px; margin: 0 auto; border: 1px solid #eee; border-radius: 20px; padding: 36px; box-shadow: 0 8px 30px rgba(0,0,0,0.06); }
    .planner-card label { font-weight: 600; font-size: 0.85rem; margin-bottom: 6px; }
    .planner-card .form-control { border-radius: 10px; padding: 10px 14px; margin-bottom: 18px; }
    .planner-submit { background: #D85A30; color: #fff; border: none; border-radius: 10px; padding: 12px; width: 100%; font-weight: 700; }
    .planner-submit:hover { background: #b8461f; color: #fff; }
</style>

<div class="container py-5">

    <div class="text-center mb-4">
        <h2 class="fw-bold"><i class="fa-solid fa-robot" style="color:#D85A30;"></i> AI Trip Planner</h2>
        <p class="text-muted">Tell us your trip details and we'll build an itinerary + match listings for you.</p>
    </div>

    <div class="planner-card">

        <form action="/trip-planner" method="POST">

            <label>Destination City</label>
            <input type="text" name="city" class="form-control" placeholder="e.g. Goa, Manali, Jaipur" required>

            <label>Number of Days</label>
            <input type="number" name="days" class="form-control" min="1" max="30" placeholder="e.g. 4" required>

            <label>Total Budget (₹)</label>
            <input type="number" name="budget" class="form-control" min="500" placeholder="e.g. 20000" required>

            <label>Number of People</label>
            <input type="number" name="people" class="form-control" min="1" max="20" placeholder="e.g. 2" required>

            <button type="submit" class="planner-submit">Generate My Trip Plan</button>

        </form>

    </div>

</div>