<% layout("/layouts/boilerplate") %>

<style>
    .success-hero {
        background: linear-gradient(135deg, #D85A30 0%, #b8461f 100%);
        border-radius: 20px 20px 0 0;
        padding: 48px 32px;
        text-align: center;
        color: #fff;
    }

    .success-hero .check-circle {
        width: 84px;
        height: 84px;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }

    .success-hero .check-circle i {
        font-size: 42px;
        color: #fff;
    }

    .booking-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    }

    .booking-ref {
        font-family: monospace;
        letter-spacing: 1px;
        background: #f8f4f1;
        padding: 4px 12px;
        border-radius: 8px;
        font-size: 0.85rem;
        color: #555;
    }

    .listing-thumb {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: 14px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #f0ede9;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        color: #777;
        font-size: 0.92rem;
    }

    .detail-value {
        font-weight: 600;
        color: #222;
        text-align: right;
    }

    .price-summary {
        background: #fbf7f4;
        border-radius: 14px;
        padding: 20px;
    }

    .status-badge {
        font-size: 0.8rem;
        padding: 6px 14px;
        border-radius: 20px;
    }

    .btn-reserve-outline {
        border: 2px solid #D85A30;
        color: #D85A30;
        font-weight: 600;
        border-radius: 12px;
        transition: all 0.2s ease;
    }

    .btn-reserve-outline:hover {
        background: #D85A30;
        color: #fff;
    }

    .btn-cancel {
        border: 2px solid #dc3545;
        color: #dc3545;
        font-weight: 600;
        border-radius: 12px;
        background: transparent;
        transition: all 0.2s ease;
    }

    .btn-cancel:hover {
        background: #dc3545;
        color: #fff;
    }

    .btn-dark-solid {
        background: #212529;
        color: #fff;
        font-weight: 600;
        border-radius: 12px;
        border: none;
    }

    .btn-dark-solid:hover {
        background: #000;
        color: #fff;
    }
</style>

<div class="container mt-4 mb-5" style="max-width: 780px;">

    <div class="booking-card">

        <div class="success-hero">

            <div class="check-circle">
                <i class="fa-solid fa-check"></i>
            </div>

            <h2 class="fw-bold mb-1">Booking Confirmed!</h2>

            <p class="mb-0" style="opacity: 0.9;">
                Your payment was successful and your stay is booked.
            </p>

        </div>

        <div class="p-4 p-md-5 bg-white">

            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">

                <span class="booking-ref">
                    Booking ID: <%= booking._id %>
                </span>

                <span class="badge status-badge <%= booking.status === 'confirmed' ? 'bg-success' : 'bg-secondary' %>">
                    <%= booking.status.charAt(0).toUpperCase() + booking.status.slice(1) %>
                </span>

            </div>

            <div class="row g-4">

                <div class="col-md-5">

                    <img
                        src="<%= booking.listing.image.url %>"
                        class="listing-thumb"
                        alt="<%= booking.listing.title %>">

                </div>

                <div class="col-md-7">

                    <h4 class="fw-bold mb-1">
                        <%= booking.listing.title %>
                    </h4>

                    <p class="text-muted mb-3">
                        <i class="fa-solid fa-location-dot me-1"></i>
                        <%= booking.listing.location %>, <%= booking.listing.country %>
                    </p>

                    <div class="detail-row">
                        <span class="detail-label">Check-In</span>
                        <span class="detail-value"><%= booking.checkIn.toDateString() %></span>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">Check-Out</span>
                        <span class="detail-value"><%= booking.checkOut.toDateString() %></span>
                    </div>

                    <div class="detail-row">
                        <span class="detail-label">Guests</span>
                        <span class="detail-value"><%= booking.guests %></span>
                    </div>

                </div>

            </div>

            <hr class="my-4">

            <div class="price-summary mb-4">

                <div class="detail-row">
                    <span class="detail-label">Total Amount Paid</span>
                    <span class="detail-value fs-5">
                        ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
                    </span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Payment Status</span>
                    <span class="detail-value">
                        <span class="badge bg-success"><%= booking.paymentStatus %></span>
                    </span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Payment ID</span>
                    <span class="detail-value" style="font-size: 0.85rem;">
                        <%= booking.paymentId %>
                    </span>
                </div>

                <% if (booking.orderId) { %>
                <div class="detail-row">
                    <span class="detail-label">Order ID</span>
                    <span class="detail-value" style="font-size: 0.85rem;">
                        <%= booking.orderId %>
                    </span>
                </div>
                <% } %>

            </div>

            <div class="d-flex flex-wrap justify-content-center gap-3">

                <a href="/bookings" class="btn btn-dark-solid px-4 py-2">
                    <i class="fa-solid fa-list me-1"></i> My Bookings
                </a>

                <a href="/bookings/<%= booking._id %>" class="btn btn-dark-solid px-4 py-2">
                    <i class="fa-solid fa-circle-info me-1"></i> View Details
                </a>

                <a href="/bookings/<%= booking._id %>/invoice" class="btn btn-reserve-outline px-4 py-2">
                    <i class="fa-solid fa-file-arrow-down me-1"></i> Download Invoice
                </a>

                <a href="/listings" class="btn btn-reserve-outline px-4 py-2">
                    <i class="fa-solid fa-compass me-1"></i> Continue Exploring
                </a>

                <% if (booking.status === "confirmed") { %>
                <button
                    type="button"
                    class="btn btn-cancel px-4 py-2"
                    onclick="if(confirm('Are you sure you want to cancel this booking?')){ document.getElementById('cancel-form-<%= booking._id %>').submit(); }">
                    <i class="fa-solid fa-xmark me-1"></i> Cancel Booking
                </button>
                <% } %>

            </div>

            <% if (booking.status === "confirmed") { %>
                <form
                    id="cancel-form-<%= booking._id %>"
                    action="/bookings/<%= booking._id %>?_method=DELETE"
                    method="POST"
                    class="d-none">
                </form>
            <% } %>

        </div>

    </div>

</div>