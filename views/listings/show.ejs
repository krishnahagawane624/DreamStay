<!-- ==========================================
     RAZORPAY CHECKOUT
========================================== -->

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>


<!-- ==========================================
     RAZORPAY PAYMENT
========================================== -->

<script>
(function () {

    const pageDataElement =
        document.getElementById("page-data");

    if (!pageDataElement) {
        console.error("Page data not found.");
        return;
    }

    let pageData;

    try {
        pageData = JSON.parse(
            pageDataElement.textContent
        );
    } catch (error) {
        console.error(
            "Unable to parse page data:",
            error
        );
        return;
    }

    const payBtn =
        document.getElementById("pay-btn");

    const bookingForm =
        document.getElementById("booking-form");

    if (!payBtn || !bookingForm) {
        console.error(
            "Payment button or booking form not found."
        );
        return;
    }

    payBtn.addEventListener(
        "click",
        async function () {

         /* ======================================
   LOGIN CHECK
====================================== */

if (!pageData.isLoggedIn) {

    alert(
        "Please login to book this property."
    );

    window.location.href =
        "/login?redirect=" +
        encodeURIComponent(
            window.location.pathname +
            window.location.search
        );

    return;
}


            /* ======================================
               GET BOOKING DETAILS
            ====================================== */

            const checkIn =
                document.getElementById(
                    "hidden-checkin"
                ).value;

            const checkOut =
                document.getElementById(
                    "hidden-checkout"
                ).value;

            const guests =
                document.getElementById(
                    "guest-count"
                ).value;


            /* ======================================
               DATE VALIDATION
            ====================================== */

            if (!checkIn || !checkOut) {

                alert(
                    "Please select check-in and check-out dates."
                );

                return;
            }


            /* ======================================
               GUEST VALIDATION
            ====================================== */

            const guestCount =
                Number(guests);

            if (
                !Number.isInteger(guestCount) ||
                guestCount < 1 ||
                guestCount > 10
            ) {

                alert(
                    "Please select between 1 and 10 guests."
                );

                return;
            }


            /* ======================================
               GET DISPLAYED TOTAL
            ====================================== */

            const totalElement =
                document.getElementById(
                    "total-price"
                );

            if (!totalElement) {

                alert(
                    "Unable to calculate booking amount."
                );

                return;
            }

            const totalAmount =
                Number(
                    totalElement.textContent
                        .replace(/[₹,]/g, "")
                        .trim()
                );

            if (
                !Number.isFinite(totalAmount) ||
                totalAmount <= 0
            ) {

                alert(
                    "Invalid booking amount."
                );

                return;
            }


            /* ======================================
               DISABLE BUTTON
            ====================================== */

            payBtn.disabled = true;
            payBtn.textContent = "Processing...";


            try {

                /* ======================================
                   CREATE RAZORPAY ORDER
                ====================================== */

                const orderResponse =
                    await fetch(
                        "/payment/create-order",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            credentials:
                                "same-origin",

                            body:
                                JSON.stringify({
                                    listingId:
                                        pageData.listingId,

                                    checkIn:
                                        checkIn,

                                    checkOut:
                                        checkOut,

                                    guests:
                                        guestCount,

                                    amount:
                                        totalAmount
                                })
                        }
                    );


                /* ======================================
                   READ ORDER RESPONSE SAFELY
                ====================================== */

                const orderText =
                    await orderResponse.text();

                let orderData;

                try {

                    orderData =
                        JSON.parse(orderText);

                } catch (error) {

                    console.error(
                        "Invalid order response:",
                        orderText
                    );

                    throw new Error(
                        "Unable to start payment. Please login again."
                    );
                }


                /* ======================================
                   CHECK ORDER RESPONSE
                ====================================== */

                if (
                    !orderResponse.ok ||
                    !orderData.success
                ) {

                    throw new Error(
                        orderData.message ||
                        "Unable to create payment order."
                    );
                }


                /* ======================================
                   RAZORPAY CHECK
                ====================================== */

                if (
                    typeof Razorpay ===
                    "undefined"
                ) {

                    throw new Error(
                        "Razorpay checkout failed to load."
                    );
                }


                /* ======================================
                   RAZORPAY OPTIONS
                ====================================== */

                const options = {

                    key:
                        pageData.razorpayKey,

                    amount:
                        orderData.amount,

                    currency:
                        orderData.currency,

                    name:
                        "DreamStay",

                    description:
                        "Property Booking",

                    order_id:
                        orderData.orderId,


                    /* ==================================
                       CUSTOMER DETAILS
                    ================================== */

                    prefill: {

                        name:
                            pageData.username ||
                            "",

                        email:
                            pageData.email ||
                            ""
                    },


                    /* ==================================
                       THEME
                    ================================== */

                    theme: {
                        color: "#D85A30"
                    },


                    /* ==================================
                       PAYMENT SUCCESS
                    ================================== */

                    handler:
                        async function (
                            response
                        ) {

                            try {

                                const verifyResponse =
                                    await fetch(
                                        "/payment/verify",
                                        {
                                            method: "POST",

                                            headers: {
                                                "Content-Type":
                                                    "application/json"
                                            },

                                            credentials:
                                                "same-origin",

                                            body:
                                                JSON.stringify({

                                                    razorpay_order_id:
                                                        response.razorpay_order_id,

                                                    razorpay_payment_id:
                                                        response.razorpay_payment_id,

                                                    razorpay_signature:
                                                        response.razorpay_signature
                                                })
                                        }
                                    );


                                /* ==========================
                                   READ VERIFY RESPONSE
                                ========================== */

                                const verifyText =
                                    await verifyResponse.text();

                                let verifyData;

                                try {

                                    verifyData =
                                        JSON.parse(
                                            verifyText
                                        );

                                } catch (error) {

                                    console.error(
                                        "Invalid verification response:",
                                        verifyText
                                    );

                                    throw new Error(
                                        "Payment verification returned an invalid response."
                                    );
                                }


                                /* ==========================
                                   CHECK VERIFICATION
                                ========================== */

                                if (
                                    !verifyResponse.ok ||
                                    !verifyData.success
                                ) {

                                    throw new Error(
                                        verifyData.message ||
                                        "Payment verification failed."
                                    );
                                }


                                /* ==================================
                                   PAYMENT VERIFIED
                                   BOOKING IS ALREADY CREATED
                                   BY /payment/verify
                                ================================== */

                                if (
                                    verifyData.bookingId
                                ) {

                                    window.location.href =
                                        "/bookings/" +
                                        verifyData.bookingId;

                                    return;
                                }


                                window.location.href =
                                    "/bookings";

                            } catch (error) {

                                console.error(
                                    "Payment verification error:",
                                    error
                                );

                                alert(
                                    error.message ||
                                    "Payment verification failed."
                                );

                                payBtn.disabled =
                                    false;

                                payBtn.textContent =
                                    "Reserve";
                            }
                        },


                    /* ==================================
                       PAYMENT MODAL DISMISS
                    ================================== */

                    modal: {

                        ondismiss:
                            function () {

                                payBtn.disabled =
                                    false;

                                payBtn.textContent =
                                    "Reserve";
                            }
                    }
                };


                /* ======================================
                   CREATE RAZORPAY INSTANCE
                ====================================== */

                const razorpayCheckout =
                    new Razorpay(options);


                /* ======================================
                   PAYMENT FAILED
                ====================================== */

                razorpayCheckout.on(
                    "payment.failed",
                    function (response) {

                        console.error(
                            "Razorpay payment failed:",
                            response.error
                        );

                        alert(
                            response.error &&
                            response.error.description
                                ? response.error.description
                                : "Payment failed."
                        );

                        payBtn.disabled =
                            false;

                        payBtn.textContent =
                            "Reserve";
                    }
                );


                /* ======================================
                   OPEN CHECKOUT — ONCE ONLY
                ====================================== */

                razorpayCheckout.open();

            } catch (error) {

                console.error(
                    "Payment initialization error:",
                    error
                );

                alert(
                    error.message ||
                    "Unable to start payment."
                );

                payBtn.disabled =
                    false;

                payBtn.textContent =
                    "Reserve";
            }
        }
    );

})();
</script>


<!-- ==========================================
     GALLERY CAPTIONS
========================================== -->

<script>
(function () {

    const captionsElement =
        document.getElementById(
            "gallery-captions-data"
        );


    const captionElement =
        document.getElementById(
            "gallery-caption"
        );


    if (
        !captionsElement ||
        !captionElement
    ) {

        return;

    }


    let captions = [];


    try {

        captions =
            JSON.parse(
                captionsElement.textContent
            );

    } catch (error) {

        console.error(
            "Unable to parse gallery captions:",
            error
        );

        return;

    }


    function showCaption(index) {

        captionElement.textContent =
            captions[index] || "";

    }


    showCaption(0);


    document
        .querySelectorAll(
            "#gallery-dots .gallery-dot"
        )
        .forEach(
            function (dot) {

                dot.addEventListener(
                    "click",
                    function () {

                        showCaption(
                            parseInt(
                                dot.dataset.index,
                                10
                            )
                        );

                    }
                );

            }
        );


    document
        .querySelectorAll(
            ".gallery-img"
        )
        .forEach(
            function (img) {

                img.addEventListener(
                    "click",
                    function () {

                        showCaption(
                            parseInt(
                                img.dataset.index,
                                10
                            )
                        );

                    }
                );

            }
        );


    function currentActiveIndex() {

        const activeDot =
            document.querySelector(
                "#gallery-dots .gallery-dot.active"
            );


        return activeDot
            ? parseInt(
                activeDot.dataset.index,
                10
            )
            : 0;

    }


    const galleryPrevBtn =
        document.getElementById(
            "gallery-prev-btn"
        );


    if (galleryPrevBtn) {

        galleryPrevBtn.addEventListener(
            "click",
            function () {

                setTimeout(
                    function () {

                        showCaption(
                            currentActiveIndex()
                        );

                    },
                    0
                );

            }
        );

    }


    const galleryNextBtn =
        document.getElementById(
            "gallery-next-btn"
        );


    if (galleryNextBtn) {

        galleryNextBtn.addEventListener(
            "click",
            function () {

                setTimeout(
                    function () {

                        showCaption(
                            currentActiveIndex()
                        );

                    },
                    0
                );

            }
        );

    }

})();
</script>